@page "/outbox"
@implements IDisposable
@inject OutboxService Outbox
@inject AuthService Auth
@inject NavigationManager Nav

<div class="mx-auto" style="max-width: 520px;">
    <div class="page-head mb-3">
        <span class="page-title-icon">
            <i class="bi bi-cloud-arrow-up"></i>
            <h4>Envíos pendientes</h4>
        </span>
        <button class="pill-btn" @onclick="() => Outbox.FlushAsync()">
            <i class="bi bi-arrow-clockwise"></i> Enviar ahora
        </button>
    </div>

    @if (items.Count == 0)
    {
        <div class="alert alert-light border text-center py-4">
            ✅ Todo enviado. No hay nada en la cola.
        </div>
    }
    else
    {
        <ul class="list-group">
            @foreach (var item in items)
            {
                <li class="list-group-item py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small">
                            <strong>@KindLabel(item.Kind)</strong>
                            @if (item.OrderId > 0)
                            {
                                <span class="text-muted">· Orden #@item.OrderId</span>
                            }
                            <br />
                            <span class="text-muted">Pulsado @item.CapturedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            @if (item.Kind == OutboxKind.Message && item.Text is not null)
                            {
                                <br /><span class="text-muted">"@(item.Text.Length > 40 ? item.Text[..40] + "…" : item.Text)"</span>
                            }
                        </span>
                        <span class="text-end">
                            @if (item.Status == OutboxStatus.Failed)
                            {
                                <span class="badge bg-danger">Error</span>
                            }
                            else if (item.Status == OutboxStatus.Sending)
                            {
                                <span class="badge bg-info text-dark">Enviando…</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pendiente</span>
                            }
                            @if (item.Attempts > 0)
                            {
                                <div class="text-muted" style="font-size: 0.6rem;">@item.Attempts intento(s)</div>
                            }
                        </span>
                    </div>
                    @if (item.Status == OutboxStatus.Failed)
                    {
                        <div class="text-danger small mt-1">@item.LastError</div>
                        <button class="btn btn-sm btn-outline-primary py-0 me-1" @onclick="() => Outbox.RetryAsync(item.Id)">Reintentar</button>
                        <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => Outbox.DiscardAsync(item.Id)">Descartar</button>
                    }
                </li>
            }
        </ul>
        <p class="text-muted small mt-2">
            Los envíos salen solos al recuperar la conexión, en el orden en que se crearon.
            Nada se descarta automáticamente.
        </p>
    }
</div>

@code {
    private List<OutboxItem> items = [];
    private bool subscribed;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.IsLoggedInAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }
        Outbox.Changed += OnChanged;
        subscribed = true;
        await RefreshAsync();
    }

    private void OnChanged() => _ = InvokeAsync(RefreshAsync);

    private async Task RefreshAsync()
    {
        items = await Outbox.GetAllAsync();
        StateHasChanged();
    }

    private static string KindLabel(OutboxKind kind) => kind switch
    {
        OutboxKind.Message => "Mensaje",
        OutboxKind.Photo => "Foto",
        OutboxKind.ClockIn => "Registro de entrada",
        OutboxKind.ClockOut => "Registro de salida",
        OutboxKind.Signature => "Firma del cliente",
        OutboxKind.Paperwork => "Papeleo",
        OutboxKind.DirectMessage => "Mensaje directo",
        _ => "?"
    };

    public void Dispose()
    {
        if (subscribed) Outbox.Changed -= OnChanged;
    }
}
