@page "/orders/{Id:int}"
@inject ApiClient Api
@inject AuthService Auth
@inject ClockState Clock
@inject NavigationManager Nav

<button class="btn btn-sm btn-outline-secondary mb-3" @onclick="@(() => Nav.NavigateTo("/"))">
    ← Volver
</button>

@if (loading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-warning">@error</div>
}
else if (order is null)
{
    <div class="alert alert-light border">Orden no encontrada o sin acceso.</div>
}
else
{
    <a class="btn btn-primary w-100 mb-2" href="/orders/@Id/chat">💬 Abrir chat de la orden</a>
    @if (isStaffUser && order.Status != OrderStatus.Completed)
    {
        <a class="btn btn-outline-success w-100 mb-2" href="/orders/@Id/sign">✍ Solicitar firma del cliente</a>
    }

    @if (documents.Any())
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header py-2 small fw-bold">✍ Documentos de firma</div>
            <ul class="list-group list-group-flush">
                @foreach (var doc in documents)
                {
                    <li class="list-group-item py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small">
                                <span class="badge @DocBadgeClass(doc.Status)">@DocStatusLabel(doc.Status)</span>
                                @if (doc.IsProvisional)
                                {
                                    <span class="badge bg-warning text-dark ms-1" style="font-size: 0.6rem;">PROVISIONAL</span>
                                }
                                <br />
                                <span class="text-muted">@doc.SignerName · @doc.SignedAtUtc?.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            </span>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenPdfAsync(doc.Id)"
                                    disabled="@openingPdf">📄 Ver</button>
                        </div>
                        @if (doc.Status == SignatureDocStatus.Rejected)
                        {
                            <div class="text-danger small mt-1">
                                ✖ Rechazado por la oficina: <strong>@doc.RejectReason</strong> — repite la firma.
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span class="fw-bold">Orden #@order.Id</span>
            <span class="badge bg-light text-dark">@order.Status</span>
        </div>
        <div class="card-body">
            <h5>@order.Title</h5>
            <p class="text-muted small mb-3">
                @order.CategoryName · Prioridad: @order.Priority
            </p>

            <dl class="row small mb-0">
                <dt class="col-4">Cliente</dt>
                <dd class="col-8">@(order.AuthorName ?? "—")</dd>

                <dt class="col-4">Conductor</dt>
                <dd class="col-8">@(order.AssignedDriverName ?? "Sin asignar")</dd>

                <dt class="col-4">Creada</dt>
                <dd class="col-8">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                @if (order.UpdatedAt is not null)
                {
                    <dt class="col-4">Actualizada</dt>
                    <dd class="col-8">@order.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                }
            </dl>

            <hr />
            <p class="mb-0" style="white-space: pre-wrap;">@order.Description</p>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private OrderDto? order;
    private List<SignatureDocumentDto> documents = [];
    private bool loading = true;
    private bool isStaffUser;
    private bool openingPdf;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.IsLoggedInAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Gating (solo conductores): mismo criterio que la lista de órdenes
        var user = await Auth.GetCurrentUserAsync();
        isStaffUser = UserRoles.IsStaff(user);
        if (UserRoles.IsDriverOnly(user))
        {
            try
            {
                await Clock.EnsureLoadedAsync(Api);
            }
            catch (Exception) { }
            if (Clock.OpenEntry is null)
            {
                Nav.NavigateTo("/clock");
                return;
            }
        }

        try
        {
            order = await Api.GetOrderAsync(Id);
            documents = await Api.GetOrderDocumentsAsync(Id);
        }
        catch (Exception)
        {
            if (!await Auth.IsLoggedInAsync())
            {
                Nav.NavigateTo("/login");
                return;
            }
            error = "No se pudo cargar la orden. Revisa la conexión con el servidor.";
        }
        loading = false;
    }

    // Descarga el PDF (con el JWT) y lo abre con el visor del sistema
    private async Task OpenPdfAsync(int documentId)
    {
        openingPdf = true;
        try
        {
            var bytes = await Api.GetDocumentPdfAsync(documentId);
            if (bytes is not null)
            {
                var path = Path.Combine(FileSystem.CacheDirectory, $"documento_{documentId}.pdf");
                await File.WriteAllBytesAsync(path, bytes);
                await Launcher.Default.OpenAsync(new OpenFileRequest("Documento de conformidad", new ReadOnlyFile(path)));
            }
        }
        catch (Exception)
        {
            // sin visor de PDF o sin red: silencioso aquí; el documento sigue en la orden
        }
        openingPdf = false;
    }

    private static string DocStatusLabel(SignatureDocStatus status) => status switch
    {
        SignatureDocStatus.AwaitingSignature => "Esperando firma",
        SignatureDocStatus.Signed => "Firmado — en revisión",
        SignatureDocStatus.Approved => "Aprobado",
        SignatureDocStatus.Rejected => "Rechazado",
        _ => status.ToString()
    };

    private static string DocBadgeClass(SignatureDocStatus status) => status switch
    {
        SignatureDocStatus.AwaitingSignature => "bg-secondary",
        SignatureDocStatus.Signed => "bg-primary",
        SignatureDocStatus.Approved => "bg-success",
        SignatureDocStatus.Rejected => "bg-danger",
        _ => "bg-light text-dark border"
    };
}
