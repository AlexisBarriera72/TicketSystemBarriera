@page "/dm"
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">✉ Mensajes</h4>
    <button class="btn btn-sm btn-outline-primary" @onclick="LoadAsync" disabled="@loading">↻</button>
</div>

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (error is not null)
{
    <div class="alert alert-warning">@error</div>
    <button class="btn btn-outline-primary w-100" @onclick="LoadAsync">Reintentar</button>
}
else if (!conversations.Any())
{
    <div class="alert alert-light border text-center py-4">No tienes conversaciones.</div>
}
else
{
    <div class="list-group">
        @foreach (var conv in conversations)
        {
            var other = conv.Participants.FirstOrDefault(p => p.Id != myUserId);
            <button class="list-group-item list-group-item-action" @onclick="@(() => Nav.NavigateTo($"/dm/{conv.Id}"))">
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">@(other?.DisplayName ?? other?.Email ?? "—")</span>
                    <small class="text-muted">@conv.LastMessage?.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                </div>
                <div class="small text-muted text-truncate">
                    @(conv.LastMessage?.Content ?? "Sin mensajes")
                </div>
            </button>
        }
    </div>
}

@code {
    private List<DirectConversationDto> conversations = [];
    private string myUserId = "";
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.IsLoggedInAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }
        myUserId = (await Auth.GetCurrentUserAsync())?.Id ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        StateHasChanged();
        try
        {
            conversations = await Api.GetConversationsAsync();
        }
        catch (Exception)
        {
            if (!await Auth.IsLoggedInAsync()) { Nav.NavigateTo("/login"); return; }
            error = "No se pudieron cargar los mensajes.";
        }
        loading = false;
    }
}
