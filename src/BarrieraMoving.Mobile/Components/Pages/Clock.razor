@page "/clock"
@implements IDisposable
@inject ApiClient Api
@inject AuthService Auth
@inject ClockState State
@inject OutboxService Outbox
@inject NavigationManager Nav

<div class="mx-auto" style="max-width: 480px;">
    <div class="section-head" style="margin-top:0;">
        <i class="bi bi-clock-history"></i><span>Fichaje</span>
    </div>

    @if (loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (loadError is not null)
    {
        <div class="alert alert-warning">@loadError</div>
        <button class="btn btn-outline-primary w-100" @onclick="LoadAsync">Reintentar</button>
    }
    else
    {
        <div class="fichaje-card mb-3 text-center">
            <div class="p-4">
                @if (State.OpenEntry is null)
                {
                    <h5 class="fw-bold mb-1">¡Aún no has fichado!</h5>
                    <p class="text-muted mb-3">Ficha para empezar tu jornada.</p>
                    <button class="btn btn-success btn-lg w-100 clock-btn" @onclick="() => DoClockAsync(clockIn: true)"
                            disabled="@(busy || pendingPunch is not null)">
                        <i class="bi bi-play-fill"></i> @(busy ? "Fichando..." : "Fichar Entrada")
                    </button>
                }
                else
                {
                    <p class="mb-1 text-muted">Trabajando desde
                        <strong>@State.OpenEntry.ClockInUtc.ToLocalTime().ToString("HH:mm")</strong>
                    </p>
                    <p class="display-6 fw-bold mb-3">@ElapsedText()</p>
                    <button class="btn btn-danger btn-lg w-100 clock-btn" @onclick="() => DoClockAsync(clockIn: false)"
                            disabled="@(busy || pendingPunch is not null)">
                        <i class="bi bi-stop-fill"></i> @(busy ? "Fichando..." : "Fichar Salida")
                    </button>
                }

                @if (pendingPunch is not null)
                {
                    <div class="alert alert-info mt-3 py-2 mb-0">
                        🕓 Fichaje pendiente de envío (pulsado a las
                        @pendingPunch.CapturedAtUtc.ToLocalTime().ToString("HH:mm")).
                        Se enviará solo al recuperar la conexión; la hora oficial la pondrá
                        el servidor al recibirlo.
                    </div>
                }
                @if (failedPunch is not null)
                {
                    <div class="alert alert-warning mt-3 py-2 mb-0">
                        ❌ @(failedPunch.Kind == OutboxKind.ClockIn ? "Entrada" : "Salida") no aceptada:
                        @failedPunch.LastError
                        <div class="mt-1">
                            <button class="btn btn-sm btn-outline-primary py-0 me-1" @onclick="() => Outbox.RetryAsync(failedPunch.Id)">Reintentar</button>
                            <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => Outbox.DiscardAsync(failedPunch.Id)">Descartar</button>
                        </div>
                    </div>
                }
                @if (actionError is not null)
                {
                    <div class="alert alert-warning mt-3 py-2 mb-0">@actionError</div>
                }
                @if (lastWithoutLocation)
                {
                    <p class="text-muted small mt-2 mb-0">Fichaje registrado sin ubicación.</p>
                }
            </div>
        </div>

        <div class="info-callout mb-3">
            <i class="bi bi-info-circle-fill"></i>
            <span>La ubicación se registra solo al fichar y es opcional: si no das permiso,
                el fichaje funciona igual.</span>
        </div>

        @if (!DriverGated)
        {
            <a href="/" class="pill-btn w-100 justify-content-center mb-3" style="height:2.9rem;">
                <i class="bi bi-clipboard-check"></i> Ver mis órdenes
            </a>
        }

        @if (history.Any())
        {
            <div class="section-head">
                <i class="bi bi-calendar-week"></i><span>Últimos fichajes</span>
            </div>
            <div class="fichaje-list">
                @foreach (var entry in history)
                {
                    <div class="fichaje-row">
                        <span class="fichaje-when">
                            <i class="bi bi-calendar3"></i>
                            @entry.ClockInUtc.ToLocalTime().ToString("dd/MM")
                            <i class="bi bi-clock ms-2"></i>
                            @entry.ClockInUtc.ToLocalTime().ToString("HH:mm")
                            – @(entry.ClockOutUtc?.ToLocalTime().ToString("HH:mm") ?? "…")
                        </span>
                        <span class="d-flex align-items-center" style="gap:0.35rem;">
                            @if (entry.ClockOutUtc is not null)
                            {
                                <span class="hour-pill">
                                    @Math.Round((entry.ClockOutUtc.Value - entry.ClockInUtc).TotalHours, 1) h
                                </span>
                            }
                            @if (entry.AutoClosed)
                            {
                                <span class="auto-pill" title="Cerrado automáticamente">Auto</span>
                            }
                        </span>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private bool loading = true;
    private bool busy;
    private string? loadError;
    private string? actionError;
    private bool lastWithoutLocation;
    private List<TimeEntryDto> history = [];
    private UserSummaryDto? user;
    private System.Threading.Timer? timer;
    private OutboxItem? pendingPunch;
    private OutboxItem? failedPunch;
    private bool subscribed;

    private bool DriverGated => UserRoles.IsDriverOnly(user) && State.OpenEntry is null;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.IsLoggedInAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }
        user = await Auth.GetCurrentUserAsync();
        if (!UserRoles.IsStaff(user))
        {
            Nav.NavigateTo("/"); // los clientes no fichan
            return;
        }

        Outbox.Changed += OnOutboxChanged;
        subscribed = true;

        await RefreshQueueStateAsync();
        await LoadAsync();
        // Refresca el "tiempo transcurrido" cada 30 s
        timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    // Cuando la cola entrega un fichaje, el estado del servidor cambia: recargar
    private void OnOutboxChanged() => _ = InvokeAsync(async () =>
    {
        var hadPending = pendingPunch is not null;
        await RefreshQueueStateAsync();
        if (hadPending && pendingPunch is null)
        {
            await LoadAsync();
        }
        StateHasChanged();
    });

    private async Task RefreshQueueStateAsync()
    {
        var items = (await Outbox.GetAllAsync())
            .Where(i => i.Kind is OutboxKind.ClockIn or OutboxKind.ClockOut)
            .ToList();
        pendingPunch = items.FirstOrDefault(i => i.Status != OutboxStatus.Failed);
        failedPunch = items.FirstOrDefault(i => i.Status == OutboxStatus.Failed);
    }

    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        StateHasChanged();
        try
        {
            State.Set(await Api.GetCurrentTimeEntryAsync());
            history = await Api.GetTimeHistoryAsync(14);
        }
        catch (Exception)
        {
            if (!await Auth.IsLoggedInAsync())
            {
                Nav.NavigateTo("/login");
                return;
            }
            loadError = "No se pudo conectar al servidor.";
        }
        loading = false;
    }

    // El fichaje va SIEMPRE por la cola: online sale en <1 s; offline queda
    // pendiente visible y se entrega al recuperar red (con la hora del dispositivo
    // como metadato — la hora de nómina la sella el servidor al recibirlo)
    private async Task DoClockAsync(bool clockIn)
    {
        if (busy || pendingPunch is not null) return;
        busy = true;
        actionError = null;
        lastWithoutLocation = false;
        StateHasChanged();

        // Ubicación opcional: si falla o se deniega, el fichaje sigue adelante
        var location = await LocationHelper.TryGetLocationAsync();
        lastWithoutLocation = location is null;

        var (ok, error) = await Outbox.EnqueueClockAsync(clockIn, location?.Latitude, location?.Longitude);
        if (!ok)
        {
            actionError = error;
        }
        await RefreshQueueStateAsync();
        busy = false;
    }

    private string ElapsedText()
    {
        var elapsed = DateTime.UtcNow - State.OpenEntry!.ClockInUtc;
        if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;
        return elapsed.TotalHours >= 1
            ? $"{(int)elapsed.TotalHours}h {elapsed.Minutes:00}m"
            : $"{elapsed.Minutes}m";
    }

    public void Dispose()
    {
        timer?.Dispose();
        if (subscribed) Outbox.Changed -= OnOutboxChanged;
    }
}
