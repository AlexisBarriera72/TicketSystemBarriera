@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-header d-flex justify-content-between align-items-center px-3"
            style="padding-top: max(env(safe-area-inset-top, 0px), @(topInset)px)">
        <span class="fw-bold">🚚 Barriera Moving</span>
        @if (isLoggedIn)
        {
            <div class="d-flex align-items-center">
                @if (isStaff)
                {
                    <a class="btn btn-sm btn-outline-light me-2" href="/clock">⏱ Fichaje</a>
                }
                <button class="btn btn-sm btn-outline-light" @onclick="LogoutAsync">Salir</button>
            </div>
        }
    </header>

    <main class="app-content p-3" style="padding-bottom: max(2rem, @(bottomInset)px)">
        @Body
    </main>
</div>

@code {
    private bool isLoggedIn;
    private bool isStaff;
    private double topInset;
    private double bottomInset;

    protected override void OnInitialized()
    {
        // Insets del sistema (barra de estado/cámara y barra de gestos): ver SafeInsets
        topInset = SafeInsets.TopCssPx();
        bottomInset = SafeInsets.BottomCssPx();
    }

    // Se ejecuta en cada navegación; mantiene los botones del header sincronizados
    protected override async Task OnParametersSetAsync()
    {
        isLoggedIn = await Auth.IsLoggedInAsync();
        isStaff = isLoggedIn && UserRoles.IsStaff(await Auth.GetCurrentUserAsync());
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        isLoggedIn = false;
        Nav.NavigateTo("/login");
    }
}
