@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject OutboxService Outbox
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-header d-flex justify-content-between align-items-center px-3"
            style="padding-top: max(env(safe-area-inset-top, 0px), @(topInset)px)">
        <span class="brand fw-bold"><i class="bi bi-truck me-1"></i> Barriera Moving</span>
        @if (isLoggedIn)
        {
            <div class="header-actions d-flex align-items-center">
                <a class="icon-btn" href="/outbox" title="Notificaciones / envíos pendientes">
                    <i class="bi bi-bell"></i>
                    @if (pendingCount > 0)
                    {
                        <span class="badge-dot">@pendingCount</span>
                    }
                </a>
                <button class="salir-btn" @onclick="LogoutAsync">Salir</button>
            </div>
        }
    </header>

    <main class="app-content p-3"
          style="padding-bottom: calc(@(hasTabs ? "4.75rem" : "2rem") + max(0px, @(bottomInset)px))">
        @Body
    </main>

    @if (hasTabs)
    {
        <nav class="bottom-nav" style="padding-bottom: max(env(safe-area-inset-bottom, 0px), @(bottomInset)px)">
            <NavLink class="nav-tab" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-clipboard-check"></i><span>Órdenes</span>
            </NavLink>

            @if (isStaff)
            {
                <NavLink class="nav-tab" href="/clock">
                    <i class="bi bi-clock-history"></i><span>Horas</span>
                </NavLink>
            }

            <NavLink class="nav-tab" href="/dm">
                <i class="bi bi-chat-dots"></i><span>Mensajes</span>
            </NavLink>

            <NavLink class="nav-tab" href="/complaints">
                <i class="bi bi-headset"></i><span>Atención</span>
            </NavLink>

            @if (isManager)
            {
                <NavLink class="nav-tab" href="/team">
                    <i class="bi bi-people"></i><span>Equipo</span>
                </NavLink>
            }
        </nav>
    }
</div>

@code {
    private bool isLoggedIn;
    private bool isStaff;
    private bool isManager;
    private double topInset;
    private double bottomInset;
    private int pendingCount;
    private bool subscribed;

    // La barra inferior solo tiene sentido cuando hay sesión (los tabs navegan a
    // rutas autenticadas). En login/terms no se muestra.
    private bool hasTabs => isLoggedIn;

    protected override async Task OnInitializedAsync()
    {
        // Insets del sistema (barra de estado/cámara y barra de gestos): ver SafeInsets
        topInset = SafeInsets.TopCssPx();
        bottomInset = SafeInsets.BottomCssPx();

        Outbox.Changed += OnOutboxChanged;
        subscribed = true;
        pendingCount = await Outbox.CountAsync();
    }

    private void OnOutboxChanged() => _ = InvokeAsync(async () =>
    {
        pendingCount = await Outbox.CountAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        if (subscribed) Outbox.Changed -= OnOutboxChanged;
    }

    // Se ejecuta en cada navegación; mantiene el header y los tabs sincronizados
    protected override async Task OnParametersSetAsync()
    {
        isLoggedIn = await Auth.IsLoggedInAsync();
        var user = isLoggedIn ? await Auth.GetCurrentUserAsync() : null;
        isStaff = UserRoles.IsStaff(user);
        isManager = UserRoles.IsManager(user);
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        isLoggedIn = false;
        Nav.NavigateTo("/login");
    }
}
