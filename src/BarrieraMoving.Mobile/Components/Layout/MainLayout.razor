@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject OutboxService Outbox
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-header d-flex justify-content-between align-items-center px-3"
            style="padding-top: max(env(safe-area-inset-top, 0px), @(topInset)px)">
        <span class="fw-bold">🚚 Barriera Moving</span>
        @if (isLoggedIn)
        {
            <div class="d-flex align-items-center">
                @if (pendingCount > 0)
                {
                    <a class="btn btn-sm btn-outline-light me-2 px-2" href="/outbox" title="Envíos pendientes">📤 @pendingCount</a>
                }
                @if (isStaff)
                {
                    <a class="btn btn-sm btn-outline-light me-2 px-2" href="/clock" title="Fichaje">⏱</a>
                }
                @if (isManager)
                {
                    <a class="btn btn-sm btn-outline-light me-2 px-2" href="/team" title="Equipo">👥</a>
                }
                <a class="btn btn-sm btn-outline-light me-2 px-2" href="/dm" title="Mensajes">✉</a>
                <a class="btn btn-sm btn-outline-light me-2 px-2" href="/complaints" title="Atención al Cliente">🎧</a>
                <button class="btn btn-sm btn-outline-light" @onclick="LogoutAsync">Salir</button>
            </div>
        }
    </header>

    <main class="app-content p-3" style="padding-bottom: max(2rem, @(bottomInset)px)">
        @Body
    </main>
</div>

@code {
    private bool isLoggedIn;
    private bool isStaff;
    private bool isManager;
    private double topInset;
    private double bottomInset;
    private int pendingCount;
    private bool subscribed;

    protected override async Task OnInitializedAsync()
    {
        // Insets del sistema (barra de estado/cámara y barra de gestos): ver SafeInsets
        topInset = SafeInsets.TopCssPx();
        bottomInset = SafeInsets.BottomCssPx();

        Outbox.Changed += OnOutboxChanged;
        subscribed = true;
        pendingCount = await Outbox.CountAsync();
    }

    private void OnOutboxChanged() => _ = InvokeAsync(async () =>
    {
        pendingCount = await Outbox.CountAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        if (subscribed) Outbox.Changed -= OnOutboxChanged;
    }

    // Se ejecuta en cada navegación; mantiene los botones del header sincronizados
    protected override async Task OnParametersSetAsync()
    {
        isLoggedIn = await Auth.IsLoggedInAsync();
        var user = isLoggedIn ? await Auth.GetCurrentUserAsync() : null;
        isStaff = UserRoles.IsStaff(user);
        isManager = UserRoles.IsManager(user);
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        isLoggedIn = false;
        Nav.NavigateTo("/login");
    }
}
