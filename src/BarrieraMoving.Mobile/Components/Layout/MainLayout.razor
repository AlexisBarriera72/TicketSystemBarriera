@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-header d-flex justify-content-between align-items-center px-3">
        <span class="fw-bold">🚚 Barriera Moving</span>
        @if (isLoggedIn)
        {
            <button class="btn btn-sm btn-outline-light" @onclick="LogoutAsync">Salir</button>
        }
    </header>

    <main class="app-content p-3">
        @Body
    </main>
</div>

@code {
    private bool isLoggedIn;

    // Se ejecuta en cada navegación; mantiene el botón "Salir" sincronizado
    protected override async Task OnParametersSetAsync()
    {
        isLoggedIn = await Auth.IsLoggedInAsync();
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        isLoggedIn = false;
        Nav.NavigateTo("/login");
    }
}
