<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @if (!IsPublicSite)
    {
        @* Precarga recursos del framework Blazor: inútil en el sitio público *@
        <ResourcePreloader />
    }
    @if (IsPublicSite)
    {
        @* Sitio público de marketing: CSS propio y ligero, sin Bootstrap *@
        <link rel="stylesheet" href="fonts/fonts.css" />
        <link rel="stylesheet" href="site.css" />
    }
    else
    {
        <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
        <link rel="stylesheet" href="lib/bootstrap-icons/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="@Assets["app.css"]" />
        <link rel="stylesheet" href="@Assets["BarrieraMoving.Server.styles.css"]" />
    }
    @if (!IsPublicSite)
    {
        @* El import map solo sirve a los módulos JS de la app interna *@
        <ImportMap />
    }
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    @if (!IsPublicSite)
    {
        @* El runtime de Blazor (~196 KB) y el modal de reconexión SOLO en la app
           interna. El sitio público es SSR estático puro: sus formularios son POST
           HTML normales, así que funciona entero sin JavaScript. *@
        <ReconnectModal />
        <script src="@Assets["_framework/blazor.web.js"]"></script>
        <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
        <script src="js/downloadHelper.js"></script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    // Las páginas públicas de marketing ("/" y "/cotizacion") usan su propio CSS
    // ligero (sin Bootstrap) y NO abren circuito interactivo.
    private static readonly string[] PublicPrefixes =
        ["/cotizacion", "/error", "/not-found", "/seguimiento"];

    private bool IsPublicSite
    {
        get
        {
            var path = HttpContext.Request.Path.Value ?? "/";
            return path == "/"
                || PublicPrefixes.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
        }
    }
}
