@* Iconos SVG en línea (originales, trazo simple). Sin emoji en el sitio público. *@
@{
    var s = Size;
}
@switch (Name)
{
    case "phone":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5 5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"/></svg>;
        break;
    case "chat":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"/></svg>;
        break;
    case "arrow":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>;
        break;
    case "check":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5 11-11"/></svg>;
        break;
    case "star":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7Z"/></svg>;
        break;
    case "truck":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4l3 3v4h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>;
        break;
    case "box":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3ZM4 7.5 12 12l8-4.5M12 12v9"/></svg>;
        break;
    case "package":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h18v12H3zM3 8l2-4h14l2 4M12 8v12M8 12h2"/></svg>;
        break;
    case "wrench":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5a4 4 0 0 0-5 5L4 16l4 4 6-6a4 4 0 0 0 5-5l-2.5 2.5L18 9l-2.5-1.5Z"/></svg>;
        break;
    case "repeat":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9a5 5 0 0 1 5-5h9l-2.5-2.5M20 15a5 5 0 0 1-5 5H6l2.5 2.5"/></svg>;
        break;
    case "trash":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>;
        break;
    case "clock":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>;
        break;
    case "mappin":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.3 7-11a7 7 0 0 0-14 0c0 4.7 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>;
        break;
    case "mail":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>;
        break;
    case "instagram":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>;
        break;
    case "facebook":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.5-1.5h1.7V3.6c-.8-.1-1.6-.15-2.4-.15-2.4 0-4 1.45-4 4.1v2.35H7.5V13h2.9v8Z"/></svg>;
        break;
    case "users":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 19.5c0-3.3 2.9-5.5 6.5-5.5s6.5 2.2 6.5 5.5"/><path d="M16.5 5.6a3.2 3.2 0 0 1 0 6.1M18 14.4c2.1.7 3.5 2.4 3.5 5.1"/></svg>;
        break;
    case "bolt":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12Z"/></svg>;
        break;
    case "shield":
        <svg viewBox="0 0 24 24" width="@s" height="@s" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 7.6 7 9 4-1.4 7-4.5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>;
        break;
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Size { get; set; } = "24";
}
