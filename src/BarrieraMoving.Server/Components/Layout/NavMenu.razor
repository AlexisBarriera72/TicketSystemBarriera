@inject IApprovalService Approvals
@inject AuthenticationStateProvider AuthProvider
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<BarrieraMoving.Server.Data.ApplicationDbContext> DbFactory
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @* La barra lateral es estrecha: marca "TCL" grande + nombre completo debajo en pequeño *@
        <a class="navbar-brand d-flex align-items-center gap-2" href="portal">
            <img src="img/logo-96.png" class="brand-logo" alt="" />
            <span class="d-flex flex-column lh-1">
                <span class="fw-bold">TCL</span>
                <span style="font-size:.62rem;letter-spacing:.02em;opacity:.85">Transporte Caribe Logistic</span>
            </span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="portal" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                @* Las cabeceras de sección viven DENTRO del bloque de permisos que
                   corresponde: así nunca queda un título con la lista vacía debajo. *@
                <div class="nav-section">Operaciones</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders/create">
                        <span class="bi bi-box-seam" aria-hidden="true"></span> Nueva Orden
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders/my-list">
                        <span class="bi bi-clipboard-check" aria-hidden="true"></span> Mis Órdenes
                    </NavLink>
                </div>

                <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Office}")" Context="staffContext">
                    <div class="nav-section">Gestión</div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/cotizaciones">
                            <span class="bi bi-envelope-paper" aria-hidden="true"></span> Cotizaciones
                            @if (quoteCount > 0)
                            {
                                <span class="badge bg-warning text-dark rounded-pill ms-auto">@quoteCount</span>
                            }
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/approvals">
                            <span class="bi bi-patch-check-fill" aria-hidden="true"></span> Aprobaciones
                            @if (approvalCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill ms-auto">@approvalCount</span>
                            }
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="@Roles.Admin" Context="adminContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/users">
                            <span class="bi bi-people-fill" aria-hidden="true"></span> Usuarios
                        </NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-section">Comunicación</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dm">
                        <span class="bi bi-chat-dots-fill" aria-hidden="true"></span> Mensajes
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="complaints">
                        <span class="bi bi-headset" aria-hidden="true"></span> Atención al Cliente
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="notifications">
                        <span class="bi bi-bell" aria-hidden="true"></span> Notificaciones
                    </NavLink>
                </div>

                <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Office}")" Context="reportContext">
                    <div class="nav-section">Reportes</div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/dashboard">
                            <span class="bi bi-bar-chart-line-fill" aria-hidden="true"></span> Dashboard
                        </NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-section">Información</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="terms">
                        <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Términos
                    </NavLink>
                </div>

                @* El cierre de sesión vive ahora en el menú de cuenta (arriba a la
                   derecha), que es donde lo busca todo el mundo. Aquí ocupaba sitio. *@
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Entrar
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-plus-fill" aria-hidden="true"></span> Crear cuenta
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="terms">
                        <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Términos
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    // Badge de "Aprobaciones": time-sensitive, así que además de cargar al entrar
    // se refresca en segundo plano (solo para Oficina/Admin, en circuitos interactivos).
    private int approvalCount;
    private int quoteCount;
    private bool isStaff;
    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        isStaff = auth.User.IsInRole(Roles.Admin) || auth.User.IsInRole(Roles.Office);
        if (isStaff)
        {
            await RefreshAsync();
            timer = new System.Threading.Timer(_ => _ = InvokeAsync(RefreshAsync), null,
                TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            approvalCount = await Approvals.GetPendingCountAsync();
            using var db = DbFactory.CreateDbContext();
            quoteCount = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
                .CountAsync(db.QuoteRequests.Where(q => !q.Handled));
            StateHasChanged();
        }
        catch { /* el badge nunca debe romper la navegación */ }
    }

    public void Dispose() => timer?.Dispose();
}
