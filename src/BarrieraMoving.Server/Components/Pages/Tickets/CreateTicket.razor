@page "/tickets/create"
@using Microsoft.AspNetCore.Authorization 
@using System.Security.Claims
@inject TicketService TicketService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider 
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Create New Ticket</PageTitle>

<div class="container mt-4">
<h2>Create New Support Ticket</h2>
<hr />

<EditForm Model="newTicket" OnValidSubmit="HandleSubmit" FormName="CreateTicketForm">
	<DataAnnotationsValidator />
	<ValidationSummary class="text-danger" />

<div class="mb-3">
	<label class="form-label">Title</label>
	<InputText @bind-Value="newTicket.Title" class="form-control" placeholder="Brief summary of the issue" />
</div>

<div class="mb-3">
	<label class="form-label">Category</label>
	<InputSelect @bind-Value="newTicket.CategoryId" class="form-select"> <option value="0"> Select a Category --</option>
	@foreach (var cat in categories)
			{
				<option value = "@cat.Id">@cat.name</option>
			}
			</InputSelect>
</div>

<div class="mb-3">
	<label class="form-label">Priority</label>
	<InputSelect @bind-Value="newTicket.Priority" class="form-select"> 
		@foreach (var priority in Enum.GetValues<TicketPriority>())
			{
				<option value="@priority">@priority</option>
			}
				
</InputSelect>
</div>
		<div class="mb-3">
			<label class="form-label">Description</label>
			<InputTextArea @bind-Value="newTicket.Description" class="form-control" rows="4" />
		</div>
		<button type="submit" class="btn btn-primary">Submit Ticket</button>
		<a href="/" class="btn btn-secondary">Cancel</a>
	</EditForm>
</div>
@code {
	private Ticket newTicket = new() { AuthorId = "", Title = "", Description = "" }; private List<Category> categories = new();
	protected override async Task OnInitializedAsync()
	{
		categories = await TicketService.GetCategoriesAsync();
	// Obtener el ID del usuario actual autenticado
	var authState = await AuthProvider.GetAuthenticationStateAsync(); 
	var user = authState.User;
	newTicket.AuthorId = user.FindFirst(ClaimTypes.NameIdentifier)?. Value ?? "";
	}
	
private async Task HandleSubmit()
	{
		if (newTicket.CategoryId == 0) return; // Validación simple de categoría
		await TicketService.CreateTicketAsync(newTicket);
		Navigation.NavigateTo("/"); // Por ahora redirigimos al Home
	}
}