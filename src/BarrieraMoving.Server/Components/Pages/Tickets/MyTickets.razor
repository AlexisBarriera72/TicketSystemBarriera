@page "/tickets/my-list"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject TicketService TicketService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize]
@rendermode InteractiveServer

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3><i class="bi bi-journal-text text-primary"></i> My Ticket List</h3>
        <a href="/tickets/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Requerimiento
   </a>
    </div>

    @if (userTickets == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading...</p>
        </div>
    }
    else if (!userTickets.Any())
    {
        <div class="alert alert-light border text-center p-5 shadow-sm">
            <i class="bi bi-emoji-smile fs-1 text-muted"></i>
            <h4 class="mt-3">No tickets found</h4>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                          <thead class="bg-light">
                    <tr>
                           <th class="ps-4">Título</th>
                                    <th>Estado</th>
                    <th>Prioridad</th>
                        <th>Creado</th>
                      <th>Acciones</th>
                         </tr>
                          </thead>
                    <tbody>
                        @foreach (var ticket in userTickets)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@ticket.Title</div>
                                    @if (ticket.AuthorId == userId && ticket.TechnicianId == userId)
                                    {
                                        <span class="badge bg-dark small" style="font-size: 0.6rem;">AUTOR Y TÉCNICO</span>
                                    }
                                    else if (ticket.AuthorId == userId)
                                    {
                                        <span class="badge bg-secondary small" style="font-size: 0.6rem;">Generado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark small" style="font-size: 0.6rem;">Asignado</span>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@ticket.Status</span></td>
                                    <td>@ticket.Priority</td>
                                          <td>@ticket.CreatedAt.ToString("dd/MM/yyyy")</td>
                                     <td>
                                          <button class="btn btn-sm btn-success"
                                            @onclick="@(() => Navigation.NavigateTo($"/tickets/manage/{ticket.Id}"))">
                                        Work on it
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
@code {
    private List<Ticket>? userTickets = new(); // Inicializamos como lista vacía para evitar null reference
    private string? userId; // Variable para almacenar el User ID del usuario autenticado

    // En este método se obtiene el User ID del usuario autenticado y luego se cargan
    // solo los tickets relacionados con ese usuario
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value; // Obtenemos el User ID del usuario autenticado

        if (!string.IsNullOrEmpty(userId))
        {
            // Se usa el nuevo método que devuelve sólo los tickets relacionados con el usuario
            userTickets = await TicketService.GetMyWorkAndRequestsAsync(userId);
        }
    }

    // Método para obtener la clase CSS según el estado del ticket
    private string GetStatusClass(TicketStatus status) => status switch
    {
        TicketStatus.Open => "bg-info text-dark",
        TicketStatus.InProgress => "bg-warning text-dark",
        TicketStatus.Resolved => "bg-success",
        _ => "bg-secondary"
    };
}