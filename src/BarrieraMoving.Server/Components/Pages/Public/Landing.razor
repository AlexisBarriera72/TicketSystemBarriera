@page "/"
@layout PublicLayout
@using BarrieraMoving.Server.Components.Public
@using BarrieraMoving.Server.Components.Layout

<HeadContent>
    <meta name="description" content="Mudanzas en todo Puerto Rico con PR Transporte Caribe. Empacamos, desmontamos, montamos y transportamos con camiones cerrados y seguros. Cotizaciones GRATIS: (787) 598-9433." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="PR Transporte Caribe — Mudanzas en todo Puerto Rico" />
    <meta property="og:description" content="Tu mudanza sin estrés comienza aquí. Cuidamos de tus pertenencias como si fueran nuestras. Cotizaciones GRATIS." />
    <meta property="og:image" content="img/site/hero.jpg" />
    <meta property="og:locale" content="es_PR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href="img/site/hero.jpg" fetchpriority="high" />
    <script type="application/ld+json">
    {
      "@@context":"https://schema.org",
      "@@type":"MovingCompany",
      "name":"PR Transporte Caribe",
      "image":"img/site/hero.jpg",
      "telephone":"+1-787-598-9433",
      "email":"prtransportecaribe@@gmail.com",
      "address":{"@@type":"PostalAddress","addressLocality":"Guaynabo","addressRegion":"PR","addressCountry":"US"},
      "areaServed":{"@@type":"State","name":"Puerto Rico"},
      "openingHours":"Mo-Su 00:00-23:59",
      "sameAs":["https://www.facebook.com/MUDANZASPRTRANSPORTECARIBE","https://www.instagram.com/mudanzasprtransportecaribe"],
      "aggregateRating":{"@@type":"AggregateRating","ratingValue":"5.0","reviewCount":"6"}
    }
    </script>
</HeadContent>

<PageTitle>PR Transporte Caribe — Mudanzas en todo Puerto Rico</PageTitle>

@* ================= 1. HERO ================= *@
<section class="hero">
    <div class="hero-grid">
        <div class="hero-copy">
            <div class="wrapin">
                <p class="eyebrow">Mudanzas · Todo Puerto Rico</p>
                <h1>Tu mudanza sin estrés <em>empieza aquí</em></h1>
                <p class="lead">Cuidamos de tus pertenencias como si fueran nuestras.</p>
                <div class="hero-cta">
                    <a class="btn btn-primary btn-lg" href="/cotizacion">Cotiza tu mudanza<Icon Name="arrow" Size="18" /></a>
                    <a class="btn btn-ghost-light btn-lg" href="@SiteInfo.TelHref"><Icon Name="phone" Size="18" />Llámanos ahora</a>
                </div>
                <div class="hero-ticks">
                    <span><Icon Name="check" Size="17" />Cotizaciones GRATIS</span>
                    <span><Icon Name="check" Size="17" />Te mudamos en 24 horas</span>
                    <span><Icon Name="check" Size="17" />Todo Puerto Rico</span>
                </div>
            </div>
        </div>
        <img class="hero-photo" src="img/site/hero.jpg"
             srcset="img/site/hero-sm.jpg 640w, img/site/hero.jpg 1280w"
             sizes="(min-width:900px) 50vw, 100vw"
             width="1280" height="960" fetchpriority="high"
             alt="Camión cerrado de PR Transporte Caribe estacionado frente a una residencia en Puerto Rico" />
    </div>
</section>

@* ================= 2. TRUST BAR ================= *@
<section class="trustbar">
    <div class="wrap">
        <ul>
            <li><Icon Name="check" Size="18" />Cotizaciones GRATIS</li>
            <li><Icon Name="check" Size="18" />Te mudamos en 24 horas</li>
            <li><Icon Name="check" Size="18" />Camiones cerrados y seguros</li>
            <li><Icon Name="check" Size="18" />Servicio en todo Puerto Rico</li>
        </ul>
    </div>
</section>

@* ================= 3. SERVICIOS ================= *@
<section class="section services">
    <div class="wrap">
        <p class="eyebrow">Lo que hacemos</p>
        <h2 class="h2">Un solo equipo para toda tu mudanza</h2>
        <p class="lead">No importa el servicio que necesites, comunícate con nosotros. ¡Estamos para ayudarte!</p>
        <div class="svc-grid">
            @foreach (var (icon, title, desc) in Services)
            {
                <div class="svc">
                    <span class="svc-ico"><Icon Name="@icon" Size="26" /></span>
                    <div>
                        <h3>@title</h3>
                        <p>@desc</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* ================= 4. ASÍ TRABAJAMOS (proceso visual) ================= *@
<section class="section proc">
    <div class="wrap">
        <p class="eyebrow">Así trabajamos</p>
        <h2 class="h2">Así cuidamos tus pertenencias</h2>
        <p class="lead">Con experiencia, delicadeza, compromiso y todos los materiales para que tu mudanza sea segura y eficaz.</p>
        <div class="proc-grid">
            @foreach (var (n, img, alt, title, desc) in Steps)
            {
                <article class="pstep">
                    <figure>
                        <img src="img/site/@(img).jpg" srcset="img/site/@(img)-sm.jpg 640w, img/site/@(img).jpg 1280w"
                             sizes="(min-width:1000px) 25vw, (min-width:620px) 50vw, 100vw"
                             loading="lazy" alt="@alt" />
                        <span class="num">@n</span>
                    </figure>
                    <div class="pstep-body">
                        <h3>@title</h3>
                        <p>@desc</p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@* ================= 5. POR QUÉ ELEGIRNOS ================= *@
<section class="section why">
    <div class="wrap">
        <p class="eyebrow">Por qué elegirnos</p>
        <h2 class="h2">Tu casa completa, en manos de un equipo que responde</h2>
        <div class="why-grid">
            @foreach (var (icon, title, desc) in Reasons)
            {
                <div class="wcard">
                    <span class="wcard-ico"><Icon Name="@icon" Size="26" /></span>
                    <h3>@title</h3>
                    <p>@desc</p>
                </div>
            }
        </div>
    </div>
</section>

@* ================= 6. BAND ================= *@
<section class="band">
    <div class="wrap">
        <h2>Servicio en todo Puerto Rico · Te mudamos en 24 horas</h2>
        <div class="rule"></div>
    </div>
</section>

@* ================= 7. RESEÑAS ================= *@
<section class="section reviews">
    <div class="wrap center">
        <p class="eyebrow">Lo que dicen nuestros clientes</p>
        <h2 class="h2">Reseñas reales de Google</h2>
        <p class="rating">
            <span class="stars">@for (var i = 0; i < 5; i++){ <Icon Name="star" Size="18" /> }</span>
            <span>5.0 · 6 reseñas en Google</span>
        </p>
        <div class="rv-grid">
            @foreach (var (quote, who, when) in Reviews)
            {
                <blockquote class="rv">
                    <span class="stars">@for (var i = 0; i < 5; i++){ <Icon Name="star" Size="16" /> }</span>
                    <q>@quote</q>
                    <footer>
                        <div class="who">@who</div>
                        <div class="when">@when · Reseña de Google</div>
                    </footer>
                </blockquote>
            }
        </div>
        <p style="margin-top:2.2rem">
            <a class="btn btn-ghost" href="@SiteInfo.GoogleReviews" target="_blank" rel="noopener">Ver todas las reseñas<Icon Name="arrow" Size="18" /></a>
        </p>
    </div>
</section>

@* ================= 8. CONTACTO ================= *@
<section class="section contact">
    <div class="wrap">
        <div class="contact-grid">
            <div>
                <p class="eyebrow">Cotizaciones GRATIS</p>
                <h2 class="h2" style="margin-bottom:.4rem">Hablemos de tu mudanza</h2>
                <a class="bigphone" href="@SiteInfo.TelHref">@SiteInfo.PhoneDisplay</a>
                <div class="contact-cta">
                    <a class="btn btn-wa" href="@SiteInfo.WaHref" target="_blank" rel="noopener"><Icon Name="chat" Size="18" />WhatsApp</a>
                    <a class="btn btn-navy" href="/cotizacion">Solicitar cotización<Icon Name="arrow" Size="18" /></a>
                </div>
                <div class="contact-rows">
                    <a href="@SiteInfo.MailHref"><Icon Name="mail" Size="20" />@SiteInfo.Email</a>
                    <a href="@SiteInfo.Instagram" target="_blank" rel="noopener"><Icon Name="instagram" Size="20" />@@mudanzasprtransportecaribe</a>
                    <a href="@SiteInfo.Facebook" target="_blank" rel="noopener"><Icon Name="facebook" Size="20" />Mudanzas PR Transporte Caribe</a>
                    <span><Icon Name="mappin" Size="20" />@SiteInfo.Locality — servicio en toda la isla</span>
                    <span><Icon Name="clock" Size="20" />Abierto 24 horas</span>
                </div>
            </div>
            <div class="contact-media">
                <img src="img/site/two-trucks.jpg" srcset="img/site/two-trucks-sm.jpg 640w, img/site/two-trucks.jpg 1280w"
                     sizes="(min-width:860px) 45vw, 100vw" loading="lazy" width="800" height="800"
                     alt="Dos camiones de Mudanzas Transporte Caribe con el logo y el teléfono en la puerta" />
            </div>
        </div>
    </div>
</section>

@* ================= 9. CTA FINAL ================= *@
<section class="cta">
    <div class="wrap">
        <h2>¿Listo para mudarte?</h2>
        <p>Cuéntanos qué necesitas y recibe tu cotización — gratis y sin compromiso.</p>
        <a class="btn btn-primary btn-lg" href="/cotizacion">Obtener mi cotización GRATIS<Icon Name="arrow" Size="18" /></a>
        <div><span class="cta-sub"><Icon Name="chat" Size="18" />O escríbenos por WhatsApp para una respuesta rápida</span></div>
        <p class="cta-alt">
            <a href="@SiteInfo.WaHref" target="_blank" rel="noopener">Abrir WhatsApp</a>
            &nbsp;·&nbsp;
            <a href="@SiteInfo.TelHref">@SiteInfo.PhoneDisplay</a>
        </p>
    </div>
</section>

@code {
    private static readonly (string Icon, string Title, string Desc)[] Services =
    {
        ("truck",   "Mudanzas residenciales", "Casas y apartamentos, en todo Puerto Rico."),
        ("box",     "Mudanzas comerciales",   "Oficinas y locales, con el menor tiempo de inactividad."),
        ("wrench",  "Desmontaje y montaje",   "Camas y muebles: los desarmamos y los volvemos a armar."),
        ("package", "Empaque profesional",    "Materiales y film para proteger cada artículo."),
        ("truck",   "Alquiler de camión con chofer", "Con conductor y equipo, cuando lo necesites."),
        ("repeat",  "Entrega y recogido",     "Delivery y transportación de mercancía por toda la isla."),
        ("box",     "Transportación de mercancía", "Movemos tu carga de un punto a otro."),
        ("trash",   "Recogido para desechar", "Nos llevamos los artículos que ya no usas."),
        ("wrench",  "Instalaciones",          "Montaje e instalación en tu nuevo espacio."),
    };

    // Proceso ILUSTRADO con fotos reales de la empresa (sustituye a la lista de texto)
    private static readonly (string N, string Img, string Alt, string Title, string Desc)[] Steps =
    {
        ("01", "sofa-wrap",   "Empleado envolviendo un sofá con film protector antes de moverlo",
               "Empacamos y protegemos", "Envolvemos y aseguramos tus muebles con todos los materiales."),
        ("02", "desk-load",   "Empleado subiendo un escritorio envuelto a la plataforma del camión",
               "Cargamos con cuidado",   "Cargamos pieza por pieza con delicadeza y equipo adecuado."),
        ("03", "two-trucks",  "Camiones cerrados de Transporte Caribe listos para salir",
               "Transportamos",          "Camiones cerrados y seguros hasta tu nuevo destino."),
        ("04", "bed-assembly","Equipo armando una cama en el nuevo hogar del cliente",
               "Montamos y entregamos",  "Armamos lo que desmontamos y colocamos todo en su lugar."),
    };

    // Beneficios: cada uno anclado en las palabras REALES de la empresa
    private static readonly (string Icon, string Title, string Desc)[] Reasons =
    {
        ("users",  "Equipo con experiencia",   "Trabajamos con experiencia, delicadeza y compromiso en cada mudanza."),
        ("shield", "Cuidamos tus muebles",     "Envolvemos y protegemos tus pertenencias como si fueran nuestras."),
        ("mappin", "Todo Puerto Rico",         "Nos movemos por toda la isla, residencial y comercial."),
        ("bolt",   "Cotización sin complicaciones", "Cotizaciones gratis y te mudamos en 24 horas."),
    };

    // Reseñas REALES de Google — verbatim, atribuidas. No editar ni inventar.
    // Las 5 estrellas por reseña son correctas: un 5.0 sobre 6 reseñas solo es
    // posible si todas son de 5 (un solo 4 daría 4.83 → Google mostraría 4.8).
    private static readonly (string Quote, string Who, string When)[] Reviews =
    {
        ("I'm very pleased with the moving company! The awesome team that helped with our move was efficient and professional and Krystal from customer service was outstanding, always attentive and available whenever we needed her. Great experience from start to finish! :)", "Cristina Vázquez-O'Neill", "hace un año"),
        ("Excelente servicio, comunicación, trato y organización. Realizaron mi mudanza de manera organizada y cuidando cada detalle. Los empleados amables y trabajadores. Lo recomiendo 100%.", "Solymar Rodriguez", "hace 8 meses"),
        ("Excelente servicio, profesional y rápido. Nos confirmaron la cita el día antes y quedaron en llamar de 8am a 9am el día de la mudanza. Llamaron a las mismas 8:00am y llegaron en menos de 20 minutos. Montaron y envolvieron todo…", "Valeria Hernandez", "hace un año"),
        ("Excelente servicio, ya los he usado dos veces para mi mudanza y la de mi abuelita y me encantó todo. Súper profesional, llegaron a tiempo, trabajaron con rapidez, no rompieron nada, me desmontaron y montaron las camas. 100/10", "Puerto Rico Boat Charters", "hace un año"),
        ("Mudaron varias cosas a un 2do piso, hicieron un excelente trabajo. Llegaron a la hora pautada y aclararon todas mis dudas en la facturación. ¡Súper recomendados!", "Sheyssa Cabiya", "hace 2 años"),
        ("Desde la secretaria hasta los muchachos a cargo de mi mudanza, ¡100% recomendados!", "Lola Lebron", "hace 9 meses"),
