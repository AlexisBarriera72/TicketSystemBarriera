@page "/orders/my-list"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Mis Órdenes</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="bi bi-truck text-primary"></i> Mis Órdenes</h3>
        <a href="/orders/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Orden
        </a>
    </div>

    @if (userOrders == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando...</p>
        </div>
    }
    else if (!userOrders.Any())
    {
        <div class="alert alert-light border text-center p-5 shadow-sm">
            <i class="bi bi-emoji-smile fs-1 text-muted"></i>
            <h4 class="mt-3">No tienes órdenes todavía</h4>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Título</th>
                            <th>Estado</th>
                            <th>Prioridad</th>
                            <th>Creado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in userOrders)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@order.Title</div>
                                    @if (order.AuthorId == userId && order.AssignedDriverId == userId)
                                    {
                                        <span class="badge bg-dark small" style="font-size: 0.6rem;">AUTOR Y CONDUCTOR</span>
                                    }
                                    else if (order.AuthorId == userId)
                                    {
                                        <span class="badge bg-secondary small" style="font-size: 0.6rem;">Generada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark small" style="font-size: 0.6rem;">Asignada</span>
                                    }
                                </td>
                                <td><span class="badge @GetStatusClass(order.Status)">@order.Status</span></td>
                                <td>@order.Priority</td>
                                <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-success"
                                            @onclick="@(() => Navigation.NavigateTo($"/orders/manage/{order.Id}"))">
                                        Ver Orden
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
@code {
    private List<Order>? userOrders = new(); // Inicializamos como lista vacía para evitar null reference
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            userOrders = await OrderService.GetMyWorkAndRequestsAsync(userId);
        }
    }

    private string GetStatusClass(OrderStatus status) => status switch
    {
        OrderStatus.Requested => "bg-info text-dark",
        OrderStatus.Assigned => "bg-secondary",
        OrderStatus.EnRoute => "bg-warning text-dark",
        OrderStatus.InProgress => "bg-warning text-dark",
        OrderStatus.PendingSignature => "bg-primary",
        OrderStatus.Completed => "bg-success",
        _ => "bg-secondary"
    };
}
