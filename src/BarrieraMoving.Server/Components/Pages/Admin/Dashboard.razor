@page "/admin/dashboard"
@using Microsoft.AspNetCore.Authorization
@inject IOrderService OrderService
@inject IReportService ReportService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer

<PageTitle>Dashboard - Barriera Moving</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-speedometer2"></i> Panel Administrativo</h3>
    <span class="text-muted">Métricas de operación en tiempo real</span>
    <button class="btn btn-outline-success" @onclick="ExportToExcel">
        <i class="bi bi-file-earmark-excel"></i> Exportar Reporte
    </button>
</div>

    @* ---- SECCIÓN DE ESTADÍSTICAS ---- *@
    <div class="row g-3 mb-5">
        <div class="col-md-3">
            <div class="card bg-primary text-white border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75 small">Total Órdenes</h6>
                    <h2 class="display-6 fw-bold">@stats["Total"]</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75 small">Activas</h6>
                    <h2 class="display-6 fw-bold">@stats["Active"]</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-dark border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75 small">Esperando Firma</h6>
                    <h2 class="display-6 fw-bold">@stats["PendingSignature"]</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75 small">Completadas</h6>
                    <h2 class="display-6 fw-bold">@stats["Completed"]</h2>
                </div>
            </div>
        </div>
    </div>

    @* ---- TABLA DE GESTIÓN ---- *@
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-secondary">Todas las Órdenes</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Título</th>
                            <th>Cliente</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Conductor</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in allOrders)
                        {
                            <tr>
                                <td class="fw-bold">@order.Title</td>
                                <td>@(order.Author?.DisplayName ?? order.Author?.Email)</td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        @order.Category?.Name
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(order.Status)">
                                        @order.Status
                                    </span>
                                </td>
                                <td>
                                    @if (order.AssignedDriver != null)
                                    {
                                        <span class="text-primary">
                                            <i class="bi bi-person-check"></i>
                                            @(order.AssignedDriver.DisplayName ?? order.AssignedDriver.Email)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">Sin asignar</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-primary shadow-sm"
                                            @onclick="@(() => Navigation.NavigateTo($"/orders/manage/{order.Id}"))">
                                        <i class="bi bi-gear-fill"></i> Gestionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
@code {
    private List<Order> allOrders = new();
    private Dictionary<string, int> stats = new()
    {
        ["Total"] = 0,
        ["Active"] = 0,
        ["PendingSignature"] = 0,
        ["Completed"] = 0,
        ["Urgent"] = 0
    };

    protected override async Task OnInitializedAsync()
    {
        allOrders = await OrderService.GetAllOrdersAsync();
        stats = await ReportService.GetOrderStatsAsync();
    }

    private string GetStatusBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Requested => "bg-info text-dark",
        OrderStatus.Assigned => "bg-secondary",
        OrderStatus.EnRoute => "bg-warning text-dark",
        OrderStatus.InProgress => "bg-warning text-dark",
        OrderStatus.PendingSignature => "bg-primary",
        OrderStatus.Completed => "bg-success",
        _ => "bg-secondary"
    };

    private async Task ExportToExcel()
    {
        try
        {
            var excelData = await ReportService.GenerateExcelReportAsync();
            var base64 = Convert.ToBase64String(excelData);
            var fileName = $"Reporte_Ordenes_{DateTime.Now:yyyyMMdd}.xlsx";
            await JS.InvokeVoidAsync("downloadFile", fileName, base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}
