<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Ticket System</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        @* ---- SECCIÓN 1: Enlaces Públicos ---- *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @* ---- SECCIÓN 2: Enlaces para Usuarios Autenticados ---- *@
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets/create">
                        <span class="bi bi-plus-square-fill" aria-hidden="true"></span> New Ticket
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tickets/my-list">
                        <span class="bi bi-list-ul" aria-hidden="true"></span> My Tickets
                    </NavLink>
                </div>

                @* ---- SECCIÓN 3: Solo para Administradores ---- *@
                <AuthorizeView Roles="@Roles.Admin" Context="adminContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/dashboard">
                            <span class="bi bi-shield-lock-fill" aria-hidden="true"></span> Dashboard
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/users">
                            <span class="bi bi-people-fill" aria-hidden="true"></span> User Management
						</NavLink>
                        </div>
                </AuthorizeView>

                @* ---- SECCIÓN 4: Gestión de Cuenta (Logout) ---- *@
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>
                            Logout (@context.User.Identity?.Name)
                        </button>
                    </form>
                </div>
            </Authorized>

            @* ---- SECCIÓN 5: Solo para Invitados (Login/Register) ---- *@
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>